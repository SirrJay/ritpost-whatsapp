{
  "manifest_version": 3,
  "name": "RitPost – Post to WhatsApp, Facebook, Instagram & X",
  "short_name": "RitPost",
  "version": "2.5.0",
  "minimum_chrome_version": "116",
  "description": "Write once, post to WhatsApp groups, Facebook groups and Pages, Instagram and X. AI writing, photo editing, emojis and scheduling.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open RitPost",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Open RitPost"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "sidePanel", "downloads", "alarms", "notifications", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://*.facebook.com/*", "https://www.instagram.com/*", "https://instagram.com/*", "https://*.cdninstagram.com/*", "https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content/facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["content/ig-mobile.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*", "https://x.com/*", "https://twitter.com/*"],
      "js": ["content/social.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
